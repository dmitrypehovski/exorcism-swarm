# Copy to .env and fill in. Never commit .env.
TEAM_HANDLE=team-crimson-raven

# The scored scenario feed (no key needed; the token is only used if the organizers enable tokens)
SCENARIO_MCP=https://api.you.com/mcp/halloween-hack-26
TEAM_TOKEN=

# You.com — grounding. Authenticates with the X-API-Key header, not a bearer token.
YDC_API_KEY=

# Parasail — inference. Primary provider; OpenRouter is the documented fallback.
PARASAIL_API_KEY=
PARASAIL_MODEL=parasail-kimi-k26
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# One — the actuator: three tools over 1000+ apps.
ONE_SECRET=
ONE_DISCORD_CONNECTION_KEY=
DISCORD_CHANNEL_ID=1564842098740695100
VENUE_DISCORD_WEBHOOK=

# The local rehearsal feed (the One starter template's facility simulation)
SIM_TICKS=6
SIM_SEED=31
SLACK_CHANNEL=
LINEAR_TEAM_KEY=
